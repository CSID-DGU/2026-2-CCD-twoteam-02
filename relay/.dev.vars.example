# 로컬 wrangler dev 용 값. 복사해서 .dev.vars 를 만든다 (git 에 올라가지 않는다).
#   cp .dev.vars.example .dev.vars
# 배포에서는 같은 이름을 wrangler secret put 으로 넣는다.

# 토큰 발급처. 이 프로젝트의 토큰만 받는다. 로컬 부하 측정에는 서비스·실험 프로젝트가 아니라 시험 프로젝트 주소를 넣는다.
SUPABASE_URL=https://<프로젝트>.supabase.co

# 위 프로젝트의 Publishable 키. 채팅을 전달할 때 보낸 사람의 토큰으로 친구·그룹을 읽는 데 쓴다 (#473).
# 비우면 채팅을 전달하지 않는다. Secret key·service_role 키를 넣지 않는다.
SUPABASE_PUBLISHABLE_KEY=

# 선택. 넣으면 이 값으로 서명한 HS256 토큰도 받는다 (측정 봇용. openssl rand -hex 32 로 만든다). 정식 서버에는 넣지 않는다.
# Supabase 의 Secret key·service_role 키를 넣지 않는다.
JWT_HS256_SECRET=

# 선택. 방 정원을 시험 때만 바꾼다. 비우면 relayLogic.ts 의 MAX_ROOM_CONNECTIONS.
ROOM_MAX_CONNECTIONS=

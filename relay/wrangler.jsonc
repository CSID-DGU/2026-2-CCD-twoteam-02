// 위치 중계 서버 설정 (#464).
// 비밀값과 Supabase 주소는 여기에 적지 않는다. 로컬은 .dev.vars, 배포는 wrangler secret put 으로 넣는다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twoteam-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false, // 올릴 때마다 생기는 미리보기 주소는 쓰지 않는다
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RelayRoom" },
      { "name": "DIRECTORY", "class_name": "ChannelDirectory" }
    ]
  },
  // 무료 플랜은 SQLite 기반 클래스만 쓸 수 있다
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ChannelDirectory"] }
  ]
}

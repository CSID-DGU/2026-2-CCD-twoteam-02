# Supabase 연결 값. 이 파일을 복사해 .env.local 을 만들고 실제 값을 채운다.
#   cp .env.example .env.local
#
# 값 찾는 곳: Supabase 대시보드 > 상단 Connect > App Frameworks
#             (또는 Settings > API Keys)
#
# 주의: Secret key(service_role)는 여기에 넣지 않는다. 브라우저에 노출되는 파일이다.

VITE_SUPABASE_URL=https://<프로젝트>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<Publishable key (anon key)>
